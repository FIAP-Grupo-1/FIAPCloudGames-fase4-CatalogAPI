# Copie para .env (que nunca vai para o git) e troque os valores.
# Nenhuma senha tem valor padrao no compose.yaml: sem o .env, o compose para e avisa.
POSTGRES_PASSWORD=troque-me
REDIS_PASS=troque-me
RABBITMQ_PASS=troque-me
# Precisa ser a mesma da UsersAPI (emissora do token) e ter 32+ caracteres.
JWT_SECRET_KEY=troque-me-por-uma-chave-com-32-ou-mais-caracteres

# Opcional: envia APM/logs para o New Relic.
NEW_RELIC_LICENSE_KEY=
